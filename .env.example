# Vena configuration — copy to `.env` and fill in.
# NEVER commit real secrets. Every value here is a safe default.
#
# How .env is loaded: run_vena.py reads VENA_* variables from the
# environment. If you use `set -a; source .env` (Linux/macOS) or copy
# these into Windows environment variables, they apply.

# --- service ---
# Bind address. MUST stay loopback; the service refuses anything else.
VENA_HOST=127.0.0.1
VENA_PORT=8765
# Where the SQLite database, checkpoints, and backups live.
VENA_DATA_DIR=./data
# Request body caps (megabytes). Oversized bodies get HTTP 413.
VENA_MAX_JSON_BODY_MB=10
VENA_MAX_AUDIO_BODY_MB=100

# --- voice ---
# Master switch for the voice pipeline (1 = on, 0 = off).
VENA_VOICE_ENABLED=1
# Speech-to-text: mock | whisper_api
VENA_STT=mock
# Used when VENA_STT=whisper_api: any OpenAI-compatible /audio/transcriptions
# endpoint (faster-whisper-server, whisper.cpp server, OpenAI, local gateway).
VENA_WHISPER_URL=http://127.0.0.1:8000
VENA_WHISPER_MODEL=whisper-1
VENA_WHISPER_API_KEY=
VENA_WHISPER_LANGUAGE=
# Text-to-speech: mock | command
VENA_TTS=mock
# Used when VENA_TTS=command, e.g. "espeak-ng --stdout -v en".
# The command must write WAV audio to stdout.
VENA_TTS_COMMAND=
# Audio playback command (WAV via stdin), e.g. "aplay" (Linux),
# "afplay" (macOS). Empty = mock player (no sound, still testable).
VENA_PLAYER_COMMAND=
# Microphone capture (1 = enable, 0 = disable). Needs `pip install sounddevice`.
VENA_MIC=0
# Always-listening "Hey Vena" wake word: OPT-IN ONLY. The default off
# means push-to-talk only; nothing is recorded until you start a session.
VENA_WAKEWORD_ENABLED=0

# --- brain (future phase; safe defaults, nothing required) ---
# Provider: mock | openai | ollama | custom. Mock keeps Vena running offline.
VENA_PROVIDER=mock
VENA_OFFLINE_ONLY=0
VENA_OPENAI_BASE_URL=https://api.openai.com/v1
VENA_OPENAI_MODEL=gpt-4o-mini
VENA_OPENAI_API_KEY=
VENA_OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
VENA_OLLAMA_MODEL=llama3.1
